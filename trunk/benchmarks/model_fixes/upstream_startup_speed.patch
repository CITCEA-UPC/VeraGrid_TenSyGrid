+@pytest.mark.parametrize("use_jit", [False, True, None])
+def test_runtime_update_preserves_sequential_reads_for_each_backend(use_jit: bool | None) -> None:
+    """Update dependencies in declaration order for Python and JIT kernels.
+
+    :param use_jit: Explicit backend selection or the automatic policy.
+    :return: None.
+    """
+    count: int = 300 if use_jit is None else 8
+    parameters: list[Var] = list(Var(f"parameter_{index}") for index in range(count))
+    time_var: Var = Var("time")
+    equations: list[Expr] = list((parameters[0] + Const(1.0),))
+    index: int
+    for index in range(1, count):
+        equations.append(parameters[index - 1] + time_var)
+    compiler: RuntimeParameterCompiler = RuntimeParameterCompiler(
+        runtime_map=dict((var.uid, index) for index, var in enumerate(parameters)),
+        fixed_map=dict(), time_uids=set((time_var.uid,)))
+    kernel: Callable = compiler.compile(equations, use_jit=use_jit)
+    values: np.ndarray = np.zeros(count)
+    fixed: np.ndarray = np.empty(0)
+    kernel(values, fixed, 2.0)
+    np.testing.assert_allclose(values, 1.0 + 2.0 * np.arange(count))
+    # Self references consume the incoming value; earlier references observe
+    # writes made during this same sweep.
+    kernel(values, fixed, 2.0)
+    np.testing.assert_allclose(values, 2.0 + 2.0 * np.arange(count))
