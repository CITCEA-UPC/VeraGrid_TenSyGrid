        {\centering\usekomafont{dedication}{\@dedication \par}}%
        \vskip \z@ \@plus3fill
        \@thanks\global\let\@thanks\@empty
        \cleardoubleemptypage
      \fi
      \ifx\TG@scr@titleplus\@empty
      \else
        \next@tdpage\null
        {\TG@scr@titleplus \par}%
        \@thanks\global\let\@thanks\@empty
