\newcommand{\disthead}[1][]{%
  \setkeys{TG@scr@dist@}{#1}%
  \settomaxwidth{\@tempdima}{
    \textbf{\@subject},
    \textbf{\authorname},
    \textbf{\titlename},
    \textbf{\distinternalname}}
  \addtolength{\@tempdima}{1em}%
  \begin{ignoremargin}
    \Ifkomavarempty{docnumber}{}{%
      \makebox[\@tempdima][l]{\textbf{\@subject}}%
      \begin{minipage}[t]{\linewidth-\@tempdima}
        \strut \usekomavar{docnumber} \par
      \end{minipage}
      \par
    }
    \ifthenelse{\equal{\@author}{\@empty}}{}{%
      \makebox[\@tempdima][l]{\textbf{\authorname}}%
      \begin{minipage}[t]{\linewidth-\@tempdima}
        \strut \@author \par
      \end{minipage}
      \par
      \vspace{-2ex}
    }
    \ifthenelse{\equal{\@title}{\@empty}}{}{%
      \makebox[\@tempdima][l]{\textbf{\titlename}}%
      \begin{minipage}[t]{\linewidth-\@tempdima}
        \strut \@title \par
      \end{minipage}
      \par
    }
    \ifthenelse{\equal{\TG@scr@dist@internal}{\@empty}}{}{%
      \makebox[\@tempdima][l]{\textbf{\distinternalname}}%
      \begin{minipage}[t]{\linewidth-\@tempdima}
        \strut \TG@scr@dist@internal \par
      \end{minipage}
      \par
      \vspace{-2ex}
    }
    \par
    \ifthenelse{\equal{\TG@scr@dist@authors}{\@empty}}{}{%
      \makebox[\@tempdima][l]{\authorsname}%
      \begin{minipage}[t]{\linewidth-\@tempdima}
        \strut \TG@scr@dist@authors \par
      \end{minipage}
      \par
    }
  \end{ignoremargin}}
