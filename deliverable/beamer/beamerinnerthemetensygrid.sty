\beamer@centeredfalse
\setbeamertemplate{title page}{%
  \begin{beamercolorbox}{title-subtitle}
  \leavevmode
  \hbox{
  \vbox{
  \ifbeamercolorempty[bg]{title}{}{\nointerlineskip}%
    \begin{beamercolorbox}[
      wd=74\TG@beamer@unitlength,left]{title}%
      \usebeamerfont{title}%
      \strut\inserttitle\strut
    \end{beamercolorbox}%
    \ifthenelse{\equal{\insertsubtitle}{\@empty}}{}{%
      \ifbeamercolorempty[bg]{subtitle}{}{\nointerlineskip}%
      \begin{beamercolorbox}[
        wd=74\TG@beamer@unitlength,left]{subtitle}%
       \usebeamerfont{subtitle}%
        \strut\insertsubtitle\strut
      \end{beamercolorbox}}
      \vfil
    }
    \vbox to 6\TG@beamer@unitlength{%
        \vfil%
        \begin{beamercolorbox}[
          wd=15\TG@beamer@unitlength,
          ht=5\TG@beamer@unitlength,right]{institute in head/foot}%
            \usebeamerfont{institute in head/foot}%
            \tglogo[
              height=4\TG@beamer@unitlength]{\usekomavar{acronym}}%
        \end{beamercolorbox}%
        \vspace*{1\TG@beamer@unitlength}
        \vfil%
      }%
  }
    \end{beamercolorbox}
    \nointerlineskip%
    \begin{beamercolorbox}[
      colsep=.1\TG@beamer@unitlength]{separation line}
    \end{beamercolorbox}%
    \vskip 3ex %\vfill%
    \ltx@ifpackageloaded{beamerposter}{}{
      \inserttitlegraphic%
      %\vfill%
    }
    \ifbeamercolorempty[bg]{author}{}{\nointerlineskip}%
    \begin{beamercolorbox}{author}%
      \usebeamerfont{author}%
      \insertauthor
    \end{beamercolorbox}%
    \vskip 1ex
    \ifbeamercolorempty[bg]{institute}{}{\nointerlineskip}%
    \begin{beamercolorbox}{institute}
      \usebeamerfont{institute}%
      \insertinstitute%
    \end{beamercolorbox}
    \ifbeamercolorempty[bg]{date}{}{\nointerlineskip}%
    \begin{beamercolorbox}{date}%
      \usebeamerfont{date}%
      \insertdate
    \end{beamercolorbox}%
    \vfill
    \insertfund
    \begin{beamercolorbox}{ack}%
      \usebeamerfont{ack}%
      \insertack
    \end{beamercolorbox}%
    \ltx@ifpackageloaded{beamerposter}{%
      \vfill}{%
      \vskip-\beamer@framebottomskip 
      %\leavevmode%
      % \hbox{%
      % \begin{beamercolorbox}[wd=\paperwidth,ht=0.1ex,dp=0.1ex,center]{}%
      %   % empty environment to raise height
      % \end{beamercolorbox}}%
      \vskip5pt
      }}
