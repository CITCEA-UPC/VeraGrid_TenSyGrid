\define@key{TG@sig@}{decoration}{\def\TG@sig@decoration{#1}}
\define@key{TG@sig@}{bgcolor}{\def\TG@sig@bgcolor{#1}}
\define@key{TG@sig@}{linecolor}{\def\TG@sig@linecolor{#1}}
\define@key{TG@sig@}{width}{\setlength{\TG@sig@width}{#1}}
