\define@key{TG@sig@}{linewidth}{\setlength{\TG@sig@linewidth}{#1}}
\newcommand*{\tgsigsetup}[1]{\setkeys{TG@sig@}{#1}}
\newboolean{TG@sig@procura}
\newsavebox{\TG@sig@ppbox}
\newlength{\TG@sig@ppboxwidth}
\newcommand*{\tgsigfield}[2][false]{{%
  \setlength{\fboxsep}{0pt}%
  \setboolean{TG@sig@procura}{#1}%
  \ifthenelse{\boolean{TG@sig@procura}}{%
    \savebox{\TG@sig@ppbox}{\procuraname}}{%
    \savebox{\TG@sig@ppbox}{}}%
  \settowidth{\TG@sig@ppboxwidth}{\usebox{\TG@sig@ppbox}}%
  \ifthenelse{\equal{\TG@sig@decoration}{plain}}{%
    \setlength{\fboxrule}{0pt}%
    \setlength{\TG@sig@linewidth}{0pt}}{%
    \ifthenelse{\equal{\TG@sig@decoration}{box}}{%
      \setlength{\fboxrule}{\TG@sig@linewidth}%
      \setlength{\TG@sig@linewidth}{0pt}}{%
      \ifthenelse{\equal{\TG@sig@decoration}{line}}{%
        \setlength{\fboxrule}{0pt}}{%
        \PackageError{tensygrid}{Invalid decoration style}{}}}}%
  \fcolorbox{\TG@sig@linecolor}{\TG@sig@bgcolor}{%
    \begin{minipage}[b]{\TG@sig@width-2\fboxrule}
      \begin{minipage}[c][%
        \dimexpr \TG@sig@height-2\fboxrule-\TG@sig@linewidth]{%
          \TG@sig@ppboxwidth}
            \strut\usebox{\TG@sig@ppbox}
      \end{minipage}%
      \begin{minipage}[c]{\dimexpr \TG@sig@width-\TG@sig@ppboxwidth}
        \ifthenelse{\isundefined{\digsigfield}}{}{%
          \begin{Form}
            \digsigfield{%
              \dimexpr \TG@sig@width-2\fboxrule-\TG@sig@ppboxwidth}{%
              \dimexpr \TG@sig@height-2\fboxrule-\TG@sig@linewidth}{#2}%
          \end{Form}%
        }
      \end{minipage}
      \ifthenelse{\equal{\TG@sig@decoration}{line}}{%
        \newline
        \textcolor{\TG@sig@linecolor}{%
          \rule{\dimexpr \TG@sig@width-2\fboxrule}{\TG@sig@linewidth}}%
      }{}%
    \end{minipage}}}}
\newlength{\TG@logo@size}
\setlength{\TG@logo@size}{16mm}
\newcounter{TG@logo@mode}
\setcounter{TG@logo@mode}{2}
\define@key{TG@logo@}{width}{
    \setcounter{TG@logo@mode}{0}
    \setlength{\TG@logo@size}{#1}}
\define@key{TG@logo@}{height}{
    \setcounter{TG@logo@mode}{1}
    \setlength{\TG@logo@size}{#1}}
\define@key{TG@logo@}{iconsize}{
    \setcounter{TG@logo@mode}{2}
    \setlength{\TG@logo@size}{#1}}
\newsavebox{\TG@logo@box}
\newsavebox{\TG@logo@minibox}
\newlength{\TG@logo@miniwidth}
\newlength{\TG@logo@miniheight}
\newcommand*{\tglogo}[2][iconsize=16mm]{%
  \setkeys{TG@logo@}{#1}%
  \IfFileExists{tglogo.pdf}{
  \savebox{\TG@logo@minibox}{%
    \includegraphics[height=10pt]{tglogo}}}{
  \savebox{\TG@logo@minibox}{%
    \includegraphics[height=10pt]{./config/tglogo}}}%
  \settowidth{\TG@logo@miniwidth}{\usebox{\TG@logo@minibox}}%
  \savebox{\TG@logo@box}{%
  \ifthenelse{\equal{#2}{\@empty}}{%
    \usebox{\TG@logo@minibox}}{\usebox{\TG@logo@minibox}}}%
  \ifthenelse{\value{TG@logo@mode}=0}{%
    \resizebox{\TG@logo@size}{!}{%
      \usebox{\TG@logo@box}}}{}%
  \ifthenelse{\value{TG@logo@mode}=1}{%
    \resizebox{!}{\TG@logo@size}{%
      \usebox{\TG@logo@box}}}{}%
  \ifthenelse{\value{TG@logo@mode}=2}{%
    \settoheight{\TG@logo@miniheight}{\usebox{\TG@logo@box}}%
    \resizebox{\TG@logo@miniwidth*\ratio{\TG@logo@size}{10pt}}{!}{%
      \usebox{\TG@logo@box}}}{}}
